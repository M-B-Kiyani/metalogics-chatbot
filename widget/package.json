{
  "name": "metalogics-chatbot-widget",
  "version": "1.0.0",
  "description": "Embeddable chatbot widget for Metalogics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "serve -s dist -l 3002",
    "start:prod": "serve -s dist -l tcp://0.0.0.0:${PORT:-3000} --cors",
    "serve": "vite preview",
    "validate": "node validate-deployment.js",
    "test:local": "WIDGET_URL=http://localhost:3002 npm run validate",
    "test:prod": "npm run validate"
  },
  "dependencies": {
    "@google/genai": "^1.29.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "serve": "^14.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
